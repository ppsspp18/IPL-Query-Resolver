# Copy to .env and adjust for your environment.
# Database (MySQL)
IPL_DB_HOST=127.0.0.1
IPL_DB_PORT=3306
IPL_DB_USER=psp
IPL_DB_PASSWORD=123456
IPL_DB_NAME=ipl_normalized

# Optional: dedicated least-privilege account for the Text-to-SQL pipeline.
# Leave blank to reuse IPL_DB_* credentials.
IPL_RO_USER=
IPL_RO_PASSWORD=

# LLM backend for Text-to-SQL (Groq, OpenAI-compatible chat completions API).
# If unset, the schema-aware rule-based engine is used instead.
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=45
